# Copy this file to .env and adjust values for local development.
# Never commit real secrets.

SETWIN_ENV=development
SETWIN_LOG_LEVEL=INFO
# This exact string is what init connects with and what you pass to psql.
# psql does not accept a +psycopg suffix. Do not put postgresql+psycopg:// in this file.
# PostgreSQL must already be running. init creates tables here and does not create the database.
# On Linux the packages do not create user setwin or database setwin. Create both, then use this URL.
#   sudo -u postgres psql -c "CREATE USER setwin WITH PASSWORD 'setwin';"
#   sudo -u postgres psql -c "CREATE DATABASE setwin OWNER setwin;"
#   psql "postgresql://setwin:setwin@127.0.0.1:5432/setwin" -c "SELECT 1"
# Skip docker compose when PostgreSQL is installed on the machine.
SETWIN_DATABASE_URL=postgresql://setwin:setwin@127.0.0.1:5432/setwin
SETWIN_API_HOST=127.0.0.1
SETWIN_API_PORT=8000
SETWIN_DATA_DIR=./data
# Browser origins allowed to call the API with cookies. Comma-separated.
# SETWIN_WEB_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# Secure session cookie. Defaults to true when SETWIN_ENV=production.
# SETWIN_COOKIE_SECURE=false
# Optional session token for CLI/API. Prefer `setwin login` which writes data/session.json.
# SETWIN_TOKEN=

# AI gateway (Ollama-first; others optional)
# Pin a provider and model per agent. Model ids may contain colons.
# Same model for every agent: set only default.
# Different models: set requirements, architecture, coding, and tests.
# SETWIN_LLM_ROUTES=requirements=openai:gpt-4o,architecture=bedrock:anthropic.claude-3-5-sonnet-20241022-v2:0,coding=ollama:qwen2.5:7b,tests=bedrock:amazon.nova-pro-v1:0
# Setup can save the same choices to data/llm-routes.json, which overrides this.
# Append readable LLM request/response (with timings) to a file. Default: false
# SETWIN_LLM_LOG_REQUESTS=false
# Default file is logs/llm.log. Application logs are logs/app.log.
# SETWIN_LLM_LOG_FILE=./logs/llm.log
# Truncate logged bodies to this many chars (0 = no truncate). Default: 16000
# SETWIN_LLM_LOG_MAX_CHARS=16000
# SETWIN_OLLAMA_BASE_URL=http://127.0.0.1:11434
# SETWIN_OLLAMA_MODEL=qwen2.5:7b
# SETWIN_OLLAMA_TIMEOUT_MS=300000
# SETWIN_OPENAI_API_KEY=
# SETWIN_OPENAI_BASE_URL=https://api.openai.com/v1
# SETWIN_OPENAI_MODEL=gpt-4o-mini
# SETWIN_ANTHROPIC_API_KEY=
# SETWIN_ANTHROPIC_MODEL=claude-3-5-haiku-latest
# SETWIN_AZURE_OPENAI_ENDPOINT=
# SETWIN_AZURE_OPENAI_API_KEY=
# SETWIN_AZURE_OPENAI_DEPLOYMENT=
# SETWIN_GEMINI_API_KEY=
# SETWIN_BEDROCK_REGION=
# SETWIN_BEDROCK_PROXY_URL=
# SETWIN_AWS_ACCESS_KEY_ID=

# Enterprise integrations (graceful when unset)
# SETWIN_JIRA_BASE_URL=
# SETWIN_JIRA_TOKEN=
# SETWIN_ADO_ORG_URL=
# SETWIN_ADO_TOKEN=
# SETWIN_CONFLUENCE_BASE_URL=
# SETWIN_CONFLUENCE_TOKEN=
# SETWIN_GITHUB_TOKEN=
# SETWIN_GITLAB_TOKEN=
# SETWIN_GITLAB_BASE_URL=
# SETWIN_BITBUCKET_TOKEN=
# SETWIN_FIGMA_TOKEN=
# SETWIN_OIDC_ISSUER=
# SETWIN_OIDC_CLIENT_ID=
# SETWIN_SAML_METADATA_URL=
